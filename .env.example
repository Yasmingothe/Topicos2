# Arquivo de exemplo com as variáveis de ambiente do projeto ZERO1
# Copie para .env se desejar customizar

# Banco de dados da aplicação
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topicos2db
DB_USER=topicos2
DB_PASSWORD=123456

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=zero1
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Backend
BACKEND_PORT=8080
BACKEND_CLIENT_ID=armas-backend

# Frontend
FRONTEND_PORT=4200
FRONTEND_CLIENT_ID=armas-frontend
