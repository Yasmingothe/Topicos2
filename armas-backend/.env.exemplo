# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# Com o .env, o "Esqueci minha senha" manda e-mail DE VERDADE pelo Gmail.
# Sem o .env, os e-mails vão para o Mailpit (http://localhost:8025).
# O .env não vai para o GitHub (está no .gitignore).

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_START_TLS=REQUIRED
MAIL_LOGIN=REQUIRED
MAIL_USUARIO=seuemail@gmail.com
# senha de APP do Google (16 letras, sem espaços) — NÃO é a senha normal do Gmail
MAIL_SENHA=xxxxxxxxxxxxxxxx
MAIL_FROM=ZERO1 <seuemail@gmail.com>
